<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Web SDK brings Options, Configuration and ASP.NET Core from the shared
       framework, so the templates compile with no package download. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../templates/csharp/*.cs" />
  </ItemGroup>
</Project>

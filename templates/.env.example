# ─────────────────────────────────────────────────────────────────────────────
# Applink configuration
#
#   cp .env.example .env
#
# `.env` MUST be git-ignored. This file is committed and must only ever contain
# placeholders — never a real applicationId or password.
#
# In production do not ship a `.env` at all: use your host's secret manager.
#
# NEVER prefix any of these with NEXT_PUBLIC_ / VITE_ / REACT_APP_ — those are
# compiled into the browser bundle and become world-readable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials ─────────────────────────────────────────────────────────────
# The only two values every Applink application needs. The applicationId is
# generated when the application is provisioned; the password is the API key
# emailed to your registered address when the application is approved.
#
# Treat the password like a payment key: it can send SMS to your whole
# subscriber base and charge money to your subscribers' mobile accounts.

APPLINK_APP_ID=APP_XXXXXX
APPLINK_PASSWORD=replace-me


# ── Service endpoints ───────────────────────────────────────────────────────
# Uncomment ONLY the endpoints for the APIs enabled on your application in the
# Applink portal. An application can only call services it was provisioned for —
# calling anything else fails with E1309 no matter how correct the payload is.
#
# Leaving an endpoint unset is how your code knows the service is unavailable:
# the client should refuse to call it rather than fail at the platform.

# ── SMS ──
#APPLINK_SMS_SEND_URL=https://api.applink.com.bd/sms/send

# ── USSD ──
#APPLINK_USSD_SEND_URL=https://api.applink.com.bd/ussd/send

# ── Subscription ──
# One endpoint serves both register (action 1) and unregister (action 0).
#APPLINK_SUBSCRIPTION_SEND_URL=https://api.applink.com.bd/subscription/send
#APPLINK_SUBSCRIPTION_QUERY_BASE_URL=https://api.applink.com.bd/subscription/query-base
# Subscription status and last-charge details, up to 10 MSISDNs per request.
#APPLINK_SUBSCRIPTION_CHARGING_INFO_URL=https://api.applink.com.bd/subscription/getSubscriberChargingInfo

# ── OTP ── (activating a subscription for a web or mobile app user)
#APPLINK_OTP_REQUEST_URL=https://api.applink.com.bd/otp/request
#APPLINK_OTP_VERIFY_URL=https://api.applink.com.bd/otp/verify

# ── CaaS ── charging. Both URLs are required: generation sends the OTP,
# verification is what actually deducts the money.
#APPLINK_CAAS_DEBIT_URL=https://api.applink.com.bd/caas/direct/debit
#APPLINK_CAAS_OTP_VERIFY_URL=https://api.applink.com.bd/caas/otp/verify
# Balance query is in the published specification but not in the rendered docs'
# navigation. Confirm with support that it is enabled before relying on it.
#APPLINK_CAAS_BALANCE_URL=https://api.applink.com.bd/caas/get/balance
